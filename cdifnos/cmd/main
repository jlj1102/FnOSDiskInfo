#!/bin/bash

### Root mode, split process:
###   collector -> runs as root, invokes smartctl, writes $TRIM_PKGVAR/cache.json
###   web       -> dropped to $TRIM_USERNAME, serves cache + embedded UI on $TRIM_SERVICE_PORT

LOG_FILE="${TRIM_PKGVAR}/info.log"
SRV="${TRIM_APPDEST}/server/cdi-server"
PATTERN="cdi-server serve.*${TRIM_SERVICE_PORT}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

status() {
    pgrep -f "${PATTERN}" > /dev/null 2>&1
}

start_process() {
    if status; then
        return 0
    fi
    if [ ! -f "${SRV}" ]; then
        echo "cdi-server not found: ${SRV}" > "${TRIM_TEMP_LOGFILE}"
        log_msg "ERROR: ${SRV} not found"
        return 1
    fi
    chmod +x "${SRV}" 2>/dev/null
    log_msg "Starting collector as root ..."
    "${SRV}" collect --data "${TRIM_PKGVAR}" --interval 10s >> ${LOG_FILE} 2>&1 &
    log_msg "Starting web service as ${TRIM_USERNAME} ..."
    runuser -u "${TRIM_USERNAME}" -- "${SRV}" serve --port "${TRIM_SERVICE_PORT}" --data "${TRIM_PKGVAR}" >> ${LOG_FILE} 2>&1 &
    sleep 1
    if status; then
        return 0
    fi
    echo "cdi-server failed to start, see ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
    return 1
}

stop_process() {
    log_msg "Stopping processes ..."
    pkill -f "${PATTERN}" 2>/dev/null
    pkill -f "cdi-server collect.*${TRIM_PKGVAR}" 2>/dev/null
    sleep 2
    pkill -9 -f "${PATTERN}" 2>/dev/null
    pkill -9 -f "cdi-server collect.*${TRIM_PKGVAR}" 2>/dev/null
    return 0
}

case $1 in
start)
    start_process || exit 1
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
